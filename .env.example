# Cortex env — sample configuration.
#
# Keys marked [required] MUST be present in .env for the referenced feature
# to work. Keys marked [optional] have safe defaults; set only when tuning.
# Never commit real secrets — .env is gitignored.

# ─── Reviewer integration ────────────────────────────────────────────────
# [optional] Enable automatic reviewer dispatch on task submit.
CORTEX_ZEUS_REVIEWER_ENABLED=1
# [optional] Agent id of the reviewer. Defaults to the configured reviewer agent.
CORTEX_ZEUS_REVIEWER_AGENT=nova

# ─── Gateway binding ────────────────────────────────────────────────────
# [optional] Gateway HTTP host. Keep on loopback in production.
# CORTEX_GATEWAY_HOST=127.0.0.1
# [optional] Gateway HTTP port. Must be 1..65535.
# CORTEX_GATEWAY_PORT=4840
# [optional] Hardens runtime checks (stricter validation). Set to "hardened" in prod.
# CORTEX_MODE=hardened
# [optional] CORS origin for the gateway; null = same-origin only.
# CORTEX_CORS_ORIGIN=
# [optional] Max request body size in bytes. Default 1 MiB.
# CORTEX_MAX_BODY_BYTES=1048576
# [optional] Comma-separated list of trusted reverse-proxy IPs for X-Forwarded-For.
# CORTEX_TRUSTED_PROXIES=

# ─── Storage / paths ────────────────────────────────────────────────────
# [optional] Override gateway SQLite path. Default: $HOME/.cortex/data/gateway.db
# CORTEX_GATEWAY_DB=
# [optional] Cortex root dir. Default: $HOME/Cortex (or wherever the installer put it).
# CORTEX_HOME=
# [optional] Hub data dir. Defaults derived from CORTEX_HOME.
# CORTEX_HUB_DIR=
# [optional] Project workspace dir. Default: $CORTEX_HOME/data/projects
# CORTEX_PROJECTS_DIR=
# [optional] Agent log directory. Default: $CORTEX_HOME/logs/agents
# CORTEX_LOG_DIR=
# [optional] Per-agent log rotation tunables.
# CORTEX_LOG_MAX_SIZE_MB=10
# CORTEX_LOG_MAX_FILES=5
# [optional] Log recovery buffer (proxy path).
# CORTEX_LOG_RECOVERY_PATH=
# [optional] Runtime scratch dir for session/project files.
# CORTEX_RUN_DIR=
# [optional] Token registry JSON path.
# CORTEX_TOKEN_REGISTRY=
# [optional] Token vault dir (per-agent env files live here).
# CORTEX_TOKEN_DIR=
# [optional] Per-agent token file (takes precedence over CORTEX_TOKEN_DIR).
# CORTEX_TOKEN_FILE=
# [optional] Override per-agent .env paths for subagent spawn.
# CORTEX_AGENTS_DIR=
# [optional] Override current-task path for subagent spawn.
# CORTEX_CURRENT_TASK_FILE=
# [optional] systemd LoadCredential dir (set automatically under systemd).
# CREDENTIALS_DIRECTORY=

# ─── Rate limits / session caps ─────────────────────────────────────────
# [optional] Auth failure rate limit (per IP, per minute).
# CORTEX_RATE_AUTH_FAIL=60
# [optional] Per-agent request rate limit (per minute).
# CORTEX_RATE_AGENT_REQ=100
# [optional] Max MCP SSE sessions.
# CORTEX_MCP_MAX_SESSIONS=100
# [optional] MCP SSE session TTL in ms.
# CORTEX_MCP_SESSION_TTL_MS=
# [optional] Max WebSocket connections per agent.
# CORTEX_MAX_WS_PER_AGENT=
# [optional] Progress-report rate limit (per task, per second). 0 disables.
# CORTEX_PROGRESS_RATE_LIMIT=
# [optional] Graceful-drain timeout in ms for gateway shutdown.
# CORTEX_DRAIN_TIMEOUT_MS=
# [optional] Channel/bridge pointer timeout in ms (fallback window).
# CORTEX_CHANNEL_POINTER_TIMEOUT_MS=

# ─── Agent / MCP client config ──────────────────────────────────────────
# [optional] Gateway URL that agents talk to. Default: http://127.0.0.1:4840
# CORTEX_API=http://127.0.0.1:4840
# [optional] Gateway URL for bridge/wakeup clients.
# CORTEX_GATEWAY_URL=http://127.0.0.1:4840
# [required per-agent in each bot .mcp.json] Agent identity.
# CORTEX_AGENT_ID=
# [required per-agent] Platform hint: "claude-code" | "codex" | "openclaw" | "ollama" | "cursor" | "cline"
# CORTEX_AGENT_PLATFORM=
# [required per-agent] Token; read from CORTEX_TOKEN_DIR/$CORTEX_AGENT_ID.env if unset.
# CORTEX_AGENT_TOKEN=
# [optional] Explicit token-file path (takes precedence over CORTEX_TOKEN_DIR).
# CORTEX_AGENT_TOKEN_FILE=

# ─── Codex reviewer adapter ─────────────────────────────────────────────
# [optional] Binary invoked for Codex subprocess. Default: codex
# CORTEX_CODEX_COMMAND=codex
# [optional] Codex app-server RPC timeout in ms.
# CORTEX_CODEX_APP_SERVER_REQUEST_TIMEOUT_MS=30000
# [optional] Stale-run detector threshold for codex reviews (ms).
# CORTEX_CODEX_REVIEW_STALE_RUN_MS=300000
# [optional] Watcher config JSON path (overrides default discovery).
# CORTEX_WATCHER_CONFIG=
# [optional] Signals that the process is a cortex-owned launch (set by launcher).
# CORTEX_OWNED_LAUNCH=

# ─── Provider API keys (NEVER commit real values) ───────────────────────
# [optional unless using that provider] Anthropic API key for claude-code runtime.
# ANTHROPIC_API_KEY=
# [optional] OpenAI API key for codex/gpt routing.
# OPENAI_API_KEY=
# [optional] OpenRouter API key.
# OPENROUTER_API_KEY=
# [optional] Ollama endpoint. Default: http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# ─── Test / integration overrides ───────────────────────────────────────
# [optional] Force no process-listing probes in tests.
# CORTEX_FORCE_NO_PROC=0
# [optional] Override model used in live-proxy integration tests.
# CORTEX_TEST_ANTHROPIC_MODEL=
# CORTEX_TEST_OPENAI_MODEL=
# CORTEX_TEST_OPENROUTER_MODEL=
# CORTEX_TEST_OLLAMA_MODEL=
# [optional] Test-only agent token (integration suites).
# TEST_AGENT_TOKEN=

# ─── Platform backend (dashboard) ───────────────────────────────────────
# [optional] Bind host for the dashboard backend.
# PLATFORM_HOST=127.0.0.1
# [optional] Log retention, in days, for the platform logs job.
# LOG_RETENTION_DAYS=30
# [optional] Explicit workspace override for installer flows.
# CORTEX_WORKSPACE=
# [optional] Explicit data-dir override (rare).
# CORTEX_DATA_DIR=
